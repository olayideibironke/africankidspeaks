{
  "expo": {
    "name": "AfricanKidSpeaks",
    "slug": "africankidspeaks",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "africankidspeaks",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF3E7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.africankidspeaks",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.westforge.africankidspeaks",
      "versionCode": 11,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {
        "origin": "africankidspeaks://"
      },
      "eas": {
        "projectId": "de71552c-36f8-4838-8d4a-45ffa4ab934e"
      }
    }
  }
}